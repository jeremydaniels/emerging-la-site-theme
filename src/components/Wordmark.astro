---
/**
 * The logo: `emerging`, a thin vertical divider, then `LA`. There is no
 * emblem, icon or monogram anywhere on this site.
 *
 * Two files exist, black and cream, and the only decision is which ground the
 * mark is sitting on. See design-system.md §12.
 *
 *   tone="auto"  follows light/dark mode (black on the light ground, cream on
 *                the dark one). The default, and right for nav and footer.
 *   tone="black" forces black. Use on Ground, Paper, or a light photo scrim.
 *   tone="cream" forces cream. Use on Ink, Well, the orange band, or a dark
 *                photo scrim.
 *
 * Sized by HEIGHT, because the lockup is wide (5.85:1) and height is what
 * keeps it reading the same across contexts. Height has a hard floor of 22px,
 * applied here with max() so a caller cannot go under it. At the floor the
 * mark is 129px wide and the lowercase `emerging` is still 11.6px tall.
 * Pass a clamp() to scale up.
 */

interface Props {
  tone?: 'auto' | 'black' | 'cream';
  /** Any CSS height. Anything under the 22px floor is clamped up to it. */
  height?: string;
  href?: string | null;
  class?: string;
}

const {
  tone = 'auto',
  height = '32px',
  href = '/',
  class: className = '',
}: Props = Astro.props;

const BLACK = '/logo/emerging-la-logo-black.svg';
const CREAM = '/logo/emerging-la-logo-cream.svg';
const ALT = 'Emerging LA';

/** viewBox of both files, trimmed to the glyph bounding box. */
const VB_W = 3804.12;
const VB_H = 650.16;
const RATIO = VB_W / VB_H;

const resolved = `max(22px, ${height})`;
/** Width follows height. Clear space is half the rendered height, on all four sides. */
const style = `height:${resolved};width:calc(${resolved} * ${RATIO.toFixed(4)});--wordmark-clear:calc(${resolved} / 2)`;

const Tag = href ? 'a' : 'span';
const tagProps = href ? { href, 'aria-label': ALT } : {};
---

<Tag {...tagProps} class:list={['wordmark', `wordmark-${tone}`, className]} style={style}>
  {
    tone !== 'cream' && (
      <img class="wordmark-black-img" src={BLACK} alt={ALT} width={Math.round(VB_W)} height={Math.round(VB_H)} />
    )
  }
  {
    tone !== 'black' && (
      <img class="wordmark-cream-img" src={CREAM} alt={ALT} width={Math.round(VB_W)} height={Math.round(VB_H)} />
    )
  }
</Tag>

<style>
  .wordmark {
    display: block;
    flex: 0 0 auto;
  }

  .wordmark img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* auto: black on the light ground, cream on the dark one.
     Keyed on data-theme only. There is no prefers-color-scheme rule anywhere
     on this site: the toggle is the only thing that changes the mode. */
  .wordmark-auto .wordmark-cream-img {
    display: none;
  }

  :global(:root[data-theme='dark']) .wordmark-auto .wordmark-black-img {
    display: none;
  }
  :global(:root[data-theme='dark']) .wordmark-auto .wordmark-cream-img {
    display: block;
  }

  /* Inside an orange band or an ink block the ground is dark in both modes. */
  :global(.on-accent) .wordmark-auto .wordmark-black-img,
  :global(.on-ink) .wordmark-auto .wordmark-black-img {
    display: none;
  }
  :global(.on-accent) .wordmark-auto .wordmark-cream-img,
  :global(.on-ink) .wordmark-auto .wordmark-cream-img {
    display: block;
  }
</style>
