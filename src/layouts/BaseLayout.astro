---
/**
 * The document shell. Head, fonts, tokens. No chrome.
 * Everything else builds on top of this.
 */
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Appended after the site name in <title>. Pass false for the home page. */
  suffix?: boolean;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  suffix = true,
  noindex = false,
  bodyClass = '',
} = Astro.props;

const fullTitle = suffix ? `${title} · ${site.name}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<!--
  data-theme is written into the markup as "light" rather than left off. Light
  is the default for everyone, including a first-time visitor whose OS is set
  to dark, and this way that holds with JavaScript disabled too.
-->
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Blocking, first thing in the head, before any style or markup: restores a
      stored choice before first paint so the page never flashes the wrong mode.
      is:inline keeps Astro from bundling or deferring it.
    */}
    {/* Kept on one line because is:inline ships it verbatim, unminified, and
        it is the only script on the site that blocks parsing. */}
    {/* prettier-ignore */}
    <script is:inline>try{localStorage.getItem("ela-theme")==="dark"&&(document.documentElement.dataset.theme="dark")}catch(e){}</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Favicon: the short mark (asterisk and LA) from design/logo-pack/03-short-mark.
         The .ico is pinned to 32x32 so browsers that prefer it over the SVG do not
         stretch it; the SVG follows the browser tab's colour scheme. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="/fonts/riegal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Courier+Prime:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
