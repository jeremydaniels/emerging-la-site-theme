---
/**
 * A numbered section header. See design-system.md §7.
 *
 *   ──  01 · START HERE
 *   LATEST ISSUES                          [trailing action, pushed right]
 *   ──────────────────────────────────────────────────────────────────────
 *
 * Numbers are per page and restart at 01 on each page.
 */

interface Props {
  /** Two digits, zero padded. */
  number: string;
  /** The eyebrow label after the number, e.g. "Start here". */
  eyebrow: string;
  /** The H2. Omit to render the eyebrow on its own. */
  title?: string;
  as?: 'h1' | 'h2' | 'h3';
  /** Draw the closing rule under the header. */
  rule?: boolean;
  class?: string;
}

const {
  number,
  eyebrow,
  title,
  as: Tag = 'h2',
  rule = true,
  class: className = '',
}: Props = Astro.props;
---

<div
  class:list={[
    'flex flex-wrap items-end gap-5',
    rule && 'border-b border-rule pb-4',
    className,
  ]}
>
  <div>
    <div class="mb-3 flex items-center gap-2.5">
      <span class="h-px w-[26px] shrink-0 bg-accent-step" aria-hidden="true"></span>
      <span
        class="t-mono text-mono-eyebrow text-accent-step"
      >{number} · {eyebrow}</span>
    </div>
    {
      title && (
        <Tag class="t-display m-0 text-display-5 text-ink">{title}</Tag>
      )
    }
  </div>
  {
    Astro.slots.has('action') && (
      <div class="ml-0 wide:ml-auto">
        <slot name="action" />
      </div>
    )
  }
</div>
