---
/**
 * Home page.
 *
 * Section numbering runs 01 to 05 and restarts on every page.
 *
 * Anchor orange, one live per viewport, in scroll order:
 *   hero CTA  →  featured issue chip  →  featured event row tint  →  the band.
 * Nothing else on this page carries a solid orange fill. The nav's Subscribe
 * is deliberately the outline button.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import IssueCard from '../components/IssueCard.astro';
import EventsTable from '../components/EventsTable.astro';
import SubscribeBand from '../components/SubscribeBand.astro';

import { site } from '../lib/site';
import { routes } from '../lib/links';
import { getLatestIssues } from '../data/issues';
import { upcomingEvents } from '../data/events';
import { photos, photoPaths } from '../data/photos';

const issues = await getLatestIssues(3);
const upcoming = upcomingEvents();

/**
 * Only 14K+ community is a verified number. Every other cell is a visible
 * placeholder, not a guess and not a rounded-down real figure.
 */
const proof = [
  { value: site.communitySize, label: 'Community', real: true },
  { value: '[TBD]', label: 'Issues published', real: false },
  { value: '[TBD]', label: 'Events hosted', real: false },
  { value: '[TBD]', label: 'Companies represented', real: false },
];
---

<SiteLayout title={site.name} suffix={false}>
  {/* strip-end is where the current issue number and date go once there is one. */}

  {/* ------------------------------------------------------------------ 01 */}
  {/*
    Hero. Changed from the mockup: the right column is the photo, not an "in
    this issue" list, and the mockup's full-width photo band below the hero is
    gone. One photo, in the four-crop-mark hero frame, portrait so it holds its
    own against the headline column.

    On mobile the photo sits BELOW the headline and the CTA. The headline is
    the whole proposition and it should be the first thing on a small screen,
    and it keeps the largest paint a block of text rather than an image.
  */}
  <section class="mx-auto max-w-page px-gutter-sm wide:px-gutter">
    <div
      class="grid grid-cols-1 items-end gap-9 pt-10 pb-9 wide:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.85fr)] wide:pt-[52px]"
    >
      <div>
        <div class="t-mono mb-[22px] flex items-center gap-2.5 text-mono-eyebrow text-accent-step">
          <span class="h-px w-[26px] bg-accent-step" aria-hidden="true"></span>
          <span>01 · Start here</span>
        </div>

        <h1 class="t-display m-0 text-display-1 text-ink">
          Home to LA's<br />most ambitious<br />
          {/*
            The rotating word. "builders" is the rendered text: it is what a
            scraper, a link preview and a no-JS visitor get, and the script
            starts its cycle from it rather than from a random index.

            The width is reserved in `em`, not px. The step is a clamp between
            46px and 124px, so a pinned pixel width would only be right at one
            viewport; the ratio of word width to font-size is constant, and
            letter-spacing is in em too, so one min-width holds at every width.
            Measured in Riegal at display-1, uppercase, with the step's
            -0.03em tracking: builders 3.863em, founders 4.173em, investors
            4.326em, operators 4.657em. 4.66em is the widest of the four, and it
            holds identically at 320px, 390px and 1200px. Nothing sits to the
            right of the word on the line, so the reserved width moves nothing.

            The wash carries the width of the CURRENT word, never the reserved
            width of the box: pinned to the box it would be 0.84em wider than
            BUILDERS needs, a fifth of the word hanging off the end. The bar inside it keeps the exact geometry the "LA tech"
            wash had, the 3% bleed and 6% baseline offset included, and the
            track it sits in is the only thing that animates.
          */}
          <span class="hero-rotator" style="min-width: 4.66em"
            ><span class="hero-rotator-wash" style="width: 3.863em" data-hero-wash aria-hidden="true"
              ><span
                class="pointer-events-none absolute -inset-x-[3%] bottom-[6%] h-[0.30em] bg-accent opacity-[0.22]"
              ></span></span
            ><span class="hero-rotator-word" data-hero-rotator>builders</span></span
          >
        </h1>

        <p class="mt-7 max-w-[62ch] text-lead font-medium text-ink-muted-aa">
          On a mission to put capital, knowledge and opportunity within reach of everyone
          building here.
        </p>

        <div class="mt-[30px] flex flex-wrap items-center gap-[18px]">
          <a href={routes.subscribe} class="btn btn-primary">Subscribe to the newsletter</a>
          <span class="t-mono text-mono-meta-lg text-ink-muted">Unsubscribe anytime</span>
        </div>
      </div>

      <PhotoFrame
        variant="portrait"
        src={photos.homeHero.src}
        alt={photos.homeHero.alt}
        brief={photos.homeHero.brief}
        path={photoPaths.homeHero}
        loading="eager"
      />
    </div>
  </section>

  {/* ------------------------------------------------------ proof strip --- */}
  <section class="px-gutter-sm pt-[34px] wide:px-gutter">
    <div class="mx-auto max-w-page border-y border-rule">
      <div class="grid grid-cols-2 wide:grid-cols-4">
        {
          proof.map((cell, i) => (
            <div
              class:list={[
                'px-[22px] py-[26px]',
                i < proof.length - 1 && 'wide:border-r wide:border-rule',
                i % 2 === 0 && 'border-r border-rule wide:border-r',
                i < 2 && 'border-b border-rule wide:border-b-0',
              ]}
            >
              <div
                class:list={[
                  't-display text-stat',
                  cell.real ? 'text-ink' : 'text-ink-faint',
                ]}
              >
                {cell.value}
              </div>
              <div class="t-mono mt-2 text-mono-meta text-ink-muted">{cell.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ 02 */}
  <section
    id="about"
    class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-[88px]"
  >
    <div class="grid grid-cols-1 items-start gap-4 wide:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] wide:gap-14">
      <div>
        <div class="t-mono mb-[18px] flex items-center gap-2.5 text-mono-eyebrow text-accent-step">
          <span class="h-px w-[26px] bg-accent-step" aria-hidden="true"></span>
          <span>02 · About</span>
        </div>
        <h2 class="t-display m-0 text-display-4 text-ink">
          LA's most ambitious people don't all come from the same five schools
        </h2>
      </div>

      <div class="pt-1.5">
        <p class="m-0 text-body-lg text-ink">
          Most people in LA never find out the room exists. The introductions that change
          a company happen somewhere, and if you didn't go to the right school or work at
          the right company, you never hear about them.
        </p>
        <p class="mt-5 text-body text-ink-muted-aa">
          Emerging LA exists so that the person you need to meet is one introduction away
          instead of one lucky accident. Anyone building here can read it and anyone can
          show up.
        </p>
        <a href={routes.about} class="btn-quiet mt-8">More about Emerging LA →</a>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ 03 */}
  <section
    id="issues"
    class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-section"
  >
    <SectionHeader number="03" eyebrow="Newsletter" title="Latest issues" class="mb-[34px]">
      <a
        slot="action"
        href={routes.archive}
        class="t-mono pb-1 text-mono-meta-lg text-accent-step">Read the archive →</a
      >
    </SectionHeader>

    <div class="grid grid-cols-1 gap-4 wide:grid-cols-3 wide:gap-[26px]">
      {issues.map((issue, i) => <IssueCard issue={issue} accent={i === 0} />)}
    </div>

    <div class="mt-9 flex justify-center">
      <a href={routes.archive} class="btn btn-secondary">See all issues in the archive</a>
    </div>
  </section>

  {/* ------------------------------------------------------------------ 04 */}
  {/*
    The whole section is absent when there is nothing upcoming, rather than
    sitting there empty. Past events live on the events page.
  */}
  {
    upcoming.length > 0 && (
      <section
        id="events"
        class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-section"
      >
        <SectionHeader number="04" eyebrow="Events" title="Upcoming events" class="mb-3" />

        <p class="mt-0 mb-[26px] text-body-sm text-ink-muted-aa">
          Anyone can attend. RSVP to hold a spot.
        </p>

        <EventsTable events={upcoming} variant="upcoming" />

        <div class="flex flex-wrap items-center justify-between gap-3.5 pt-[22px]">
          <span class="t-mono text-mono-meta-lg text-ink-muted">
            More dates added regularly
          </span>
          <a href={routes.events} class="btn-quiet">
            See all events →
          </a>
        </div>
      </section>
    )
  }

  {/* ------------------------------------------------------------------ 05 */}
  <SubscribeBand number="05" />

</SiteLayout>

<style>
  /* The reserved-width box. The min-width is set inline in the markup, next to
     the note explaining the em. */
  .hero-rotator {
    position: relative;
    display: inline-block;
    vertical-align: top;
  }

  /* The wash track. It is sized to the word on show, not to the box, and its
     width is the only thing that animates: the bar inside is inset by a
     percentage of this track, so the 3% bleed follows the word for nothing.
     Same duration and easing as the word, started in the same frame as the
     fade back in, so the two read as one movement. */
  .hero-rotator-wash {
    position: absolute;
    inset-block: 0;
    left: 0;
    transition: width 0.2s ease;
  }

  /* A crossfade and nothing else. §13 of the design system allows almost no
     motion, so no slide, no settle, no typewriter. The global
     prefers-reduced-motion block already flattens both durations, and the
     script never starts under that setting anyway.

     position: relative is what keeps the word above the wash. The old "LA tech"
     wash used -z-10 for that; two positioned siblings in document order do the
     same job without leaning on the stacking context of an ancestor. */
  .hero-rotator-word {
    position: relative;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .hero-rotator-word[data-state='out'] {
    opacity: 0;
  }
</style>

<script>
  /**
   * The last word of the hero headline cycles. Scoped script, no framework, no
   * island, in line with the three other interactive spots on the site.
   *
   * Three things are load bearing:
   *   - The cycle starts at the word the server rendered, so "builders" is
   *     always what loads and the order is stable, never random.
   *   - Under prefers-reduced-motion: reduce nothing runs at all. No interval
   *     is created and the headline stays "builders" for good.
   *   - The interval is cleared while the tab is hidden, so a backgrounded tab
   *     is not repainting a headline nobody is looking at.
   *
   * The wash behind the word is sized from the same table, in the same frame as
   * the fade back in, so it grows with the new word rather than after it.
   */
  const rotator = document.querySelector<HTMLElement>('[data-hero-rotator]');
  const wash = document.querySelector<HTMLElement>('[data-hero-wash]');

  if (rotator && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const word = rotator;
    const words = ['builders', 'founders', 'investors', 'operators'];
    // The same measured em widths the reserved min-width came from, in the same
    // order as the words. The wash is set from this table rather than from a
    // getBoundingClientRect per swap: the ratio of word width to font-size is
    // fixed, so one value per word is right at every viewport.
    const washes = ['3.863em', '4.173em', '4.326em', '4.657em'];
    let index = 0;
    let cycle = 0;
    let swap = 0;

    function advance() {
      word.dataset.state = 'out';
      swap = window.setTimeout(() => {
        index = (index + 1) % words.length;
        word.textContent = words[index];
        if (wash) wash.style.width = washes[index];
        word.dataset.state = 'in';
      }, 200);
    }

    function start() {
      if (!cycle) cycle = window.setInterval(advance, 2000);
    }

    function stop() {
      window.clearInterval(cycle);
      window.clearTimeout(swap);
      cycle = 0;
      // Stopping mid fade would leave the word invisible.
      word.dataset.state = 'in';
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  }
</script>
