---
/**
 * The ruled events table. See design-system.md §8.
 *
 * One component renders both views:
 *
 *   <EventsTable events={upcomingEvents(await getEvents())} variant="upcoming" />
 *   <EventsTable events={pastEvents(await getEvents())} variant="past" />
 *
 * The two variants share the layout completely. Every difference between them
 * lives in the VARIANTS table below. It lands in the trailing cell of each row
 * plus its column heading, and, for the year, in the date block of a past row. Nothing else in the markup
 * reads `variant`, so the row structure cannot drift between the two. If you
 * ever need a second branch, put it in VARIANTS rather than in the template.
 *
 * Two layouts, one component. Below 900px each event is the phone block: one mono line of
 * date, time and city, the title clamped to three lines, the host, a square cover on the right
 * and the RSVP link across the foot, with no tint on any row. From 900px up it is the ruled
 * desktop row, which none of that touches: the phone block is `wide:hidden` and the desktop row is
 * `hidden wide:flex`, so neither can leak into the other.
 *
 * A row with no `image` renders without a photo: the cell is a blank spacer on
 * wide screens so the columns stay lined up with the header, and it is gone on
 * narrow ones. There is no placeholder box on the live site.
 *
 * Renders nothing at all when the list is empty. The caller decides whether an
 * empty list means "hide the whole section" or "show an empty state".
 */
import PhotoFrame from './PhotoFrame.astro';
import { monthShort, monthDayShort, dayOfMonth, machineDate, yearOf } from '../lib/format';
import { links } from '../lib/links';
import type { EventItem } from '../data/events';
// Callers pass data from getEvents() in src/data/events.ts.

interface Props {
  events: EventItem[];
  variant?: 'upcoming' | 'past';
  /** Tints the first row, the soonest event. A view decision, not a property of an event. */
  accentFirst?: boolean;
  class?: string;
}

const { events, variant = 'upcoming', accentFirst = false, class: className = '' }: Props = Astro.props;

/**
 * The whole of the difference between the two tables.
 *
 * `fallback` is where a row points when it has no url of its own: an upcoming
 * event can still send you to the Luma calendar, a past one has nowhere to go
 * until its recap exists.
 */
const VARIANTS = {
  upcoming: {
    heading: 'RSVP',
    cta: 'RSVP',
    fallback: links.lumaCalendar as string | null,
    pending: '[LINK]',
    showYear: false,
  },
  past: {
    heading: 'Recap',
    cta: 'Photos',
    fallback: null as string | null,
    pending: '[SOON]',
    // A past list spans years, so the date block says which one.
    showYear: true,
  },
} as const;

const v = VARIANTS[variant];
---

{
  events.length > 0 && (
    <div class={className}>
      <div class="row-head hidden wide:flex">
        <span class="flex-[0_0_46px]">No.</span>
        <span class="flex-[0_0_92px]">Date</span>
        <span class="flex-[0_0_96px]">Photo</span>
        <span class="flex-auto">Event</span>
        <span class="flex-[0_0_200px]">Location</span>
        <span class="flex-[0_0_96px] text-right">{v.heading}</span>
      </div>

      {events.map((event, i) => {
        const href = event.url ?? v.fallback;
        const index = String(i + 1).padStart(2, '0');

        const mobileLine = [
          `${monthDayShort(event.date)}${v.showYear && event.date ? `, ${yearOf(event.date)}` : ''}`,
          event.timeShort,
          event.city,
        ].filter(Boolean);

        return (
          <Fragment>
            {/* Phone layout. Hidden from 900px up. */}
            <div class="border-b border-hairline py-[18px] wide:hidden">
              <div class="flex items-start gap-4">
                <div class="min-w-0 flex-1">
                  {/* One mono line. Each part is kept whole, so on a narrow phone it wraps between
                      the date, the time and the city and never inside one of them. */}
                  <div class="t-mono text-mono-meta tracking-[0.1em] text-ink-muted">
                    <time class="whitespace-nowrap text-accent-step" datetime={machineDate(event.date)}>
                      {mobileLine[0]}
                    </time>
                    {mobileLine.slice(1).map((part) => (
                      <Fragment>
                        {' · '}
                        <span class="whitespace-nowrap">{part}</span>
                      </Fragment>
                    ))}
                  </div>
                  <h3 class="t-title m-0 mt-1.5 line-clamp-3 text-body leading-[1.2] break-words text-ink">
                    {event.name}
                  </h3>
                  {event.note && (
                    <div class="mt-1.5 line-clamp-2 text-note text-ink-muted-aa">{event.note}</div>
                  )}
                </div>

                {event.image && (
                  <PhotoFrame
                    variant="thumb"
                    src={event.image}
                    alt={event.imageAlt ?? ''}
                    loading="lazy"
                    class="w-[88px] flex-none"
                  />
                )}
              </div>

              {href ? (
                <a
                  href={href}
                  rel="noopener"
                  target="_blank"
                  class="t-mono mt-2 flex min-h-11 w-full items-center text-mono-tab text-accent-step transition-opacity hover:opacity-70"
                >
                  {v.cta} →
                </a>
              ) : (
                <span class="t-mono mt-2 flex min-h-11 w-full items-center text-mono-tab text-ink-faint">
                  {v.pending}
                </span>
              )}
            </div>

            {/* Desktop row. Hidden below 900px. */}
          <div class:list={['row hidden wide:flex', accentFirst && i === 0 && 'row-featured']}>
            <span class="t-mono hidden flex-[0_0_46px] text-mono-index text-ink-faint wide:block">
              {index}
            </span>

            <div class="row-date flex-[0_0_92px]">
              <span class="t-mono text-mono-label text-accent-step">
                {monthShort(event.date)}{v.showYear && ` ${yearOf(event.date)}`}
              </span>
              <time class="t-display text-day text-ink" datetime={machineDate(event.date)}>
                {dayOfMonth(event.date)}
              </time>
            </div>

            {event.image ? (
              <PhotoFrame
                variant="thumb"
                src={event.image}
                alt={event.imageAlt ?? ''}
                loading="lazy"
                class="flex-[0_0_96px]"
              />
            ) : (
              <div class="hidden flex-[0_0_96px] wide:block" aria-hidden="true" />
            )}

            <div class="min-w-0 flex-[1_1_220px]">
              <div class="t-title text-title-2 text-ink">{event.name}</div>
              {event.note && <div class="mt-[5px] text-note text-ink-muted-aa">{event.note}</div>}
            </div>

            <div class="t-mono hidden flex-[0_0_200px] text-mono-meta-lg text-ink-muted wide:block">
              {event.location}
              {event.time && <span class="block">{event.time}</span>}
            </div>

            {href ? (
              <a
                href={href}
                rel="noopener"
                target="_blank"
                class="t-mono ml-auto flex-[0_0_96px] text-right text-mono-tab text-accent-step transition-opacity hover:opacity-70"
              >
                {v.cta} →
              </a>
            ) : (
              <span class="t-mono ml-auto flex-[0_0_96px] text-right text-mono-tab text-ink-faint">
                {v.pending}
              </span>
            )}
          </div>
          </Fragment>
        );
      })}
    </div>
  )
}
