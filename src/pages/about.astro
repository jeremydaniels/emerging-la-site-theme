---
/**
 * About page.
 *
 * Second page of the same document as home: same section numbering restarting
 * at 01, same eyebrow, same frames, same rhythm.
 *
 * The subscribe band is the only anchor-orange element on this page.
 *
 * Desktop and mobile are two layouts, not one that reflows. Every section
 * below pairs a stacked mobile arrangement with a deliberate wide one:
 *
 *   01 header   headline over prose      →  headline left, prose right
 *   02 purpose  label over statement     →  label left, statement right
 *      photos   frames stacking in place →  three across
 *   03 what     three stacked blocks     →  three ruled columns
 *   04 numbers  2 x 2                    →  four across
 *   05 note     portrait over the note   →  portrait left, note right
 *   06 subscribe
 *
 * Nothing here has a fixed height. Prose is capped in ch so the line length
 * stays sane whatever the copy does, and the three-column grid draws its
 * dividers with a 1px gap over a ruled ground rather than per-cell borders, so
 * it holds at any cell height and a longer block just makes the row taller.
 *
 * Every [SLOT: …] is copy that has not been written or a number that has not
 * been verified. They render literally, on the page, at the size the real
 * thing will take. Do not fill one in with a guess.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import SubscribeBand from '../components/SubscribeBand.astro';

import { aboutOpening, site } from '../lib/site';
import { photos, photoPaths } from '../data/photos';

/**
 * The two statements. Same treatment, so they are one array and one row
 * template: nothing can drift between them.
 */
const statements = [
  {
    label: 'Our mission',
    text: "We're building a community making sure the most ambitious builders in Los Angeles have access to the capital, knowledge and opportunity they need.",
  },
  {
    label: 'Our vision',
    text: 'We want a Los Angeles where the most ambitious people in the country want to build, and everything they need to do it is already here.',
  },
];

/**
 * Three things, two paragraphs each. A paragraph is an array of parts so that
 * an unfilled slot can sit mid-sentence: `isSlot` picks the bracketed parts out
 * and renders them at full ink strength against the muted body colour around
 * them, so they are visible on the page. The text of a part is never touched.
 */
const doing = [
  {
    name: 'The newsletter',
    paras: [
      [
        "We write a newsletter about what's actually happening in LA tech, written for" +
          ' the people building here. We talk about the latest rounds that have closed,' +
          ' investors behind them, and we most especially put a spotlight on the founders' +
          ' building here and the companies being built.',
      ],
      [
        "This isn't the national tech news you might read somewhere else. If it didn't" +
          " happen here, we don't talk about it.",
      ],
    ],
  },
  {
    name: 'The events',
    paras: [
      [
        '[SLOT: number]',
        ' events since ',
        '[SLOT: year]',
        '. Every year, we host multiple events to get founders, investors, and' +
          ' operators in the same room at the same time.',
      ],
      [
        'LA is spread across an hour of traffic in every direction, and the tech scene' +
          ' is spread with it. Getting everyone in one place is most of the work.',
      ],
    ],
  },
  {
    name: 'The fellowship',
    paras: [
      [
        'The Emerging VC Fellowship puts students from LA schools inside real venture' +
          ' firms for a full cohort. Most of them had no route into venture before it. ',
        '[SLOT: one line on where fellows have been placed.]',
      ],
      ["It's the clearest version of what the rest of this is for."],
    ],
  },
];

/**
 * The photo band between 02 and 03. Three 4/5 frames, so they line up across on
 * wide and stack over each other on narrow. All three are empty slots: the
 * photographs come later and the frame is already rendering at the final ratio,
 * so nothing reflows when they land. The stacking itself is .photo-stack in
 * global.css.
 */
const band = [
  { slot: photos.aboutBandRoom, path: photoPaths.aboutBandRoom },
  { slot: photos.aboutBandPeople, path: photoPaths.aboutBandPeople },
  { slot: photos.aboutBandCity, path: photoPaths.aboutBandCity },
];

/** A part is a slot when it is wrapped in the bracket marker. */
const isSlot = (part: string) => part.startsWith('[SLOT:');

/**
 * Only 15K+ community is a verified number, and it reads from site.ts rather
 * than being typed here. Every other cell is a visible placeholder, not a
 * guess and not a rounded-down real figure.
 */
const proof = [
  { value: site.communitySize, label: 'Community', real: true },
  { value: '[TBD]', label: 'Issues published', real: false },
  { value: '[TBD]', label: 'Events hosted', real: false },
  { value: '[TBD]', label: 'Companies represented', real: false },
];
---

<SiteLayout
  title="About"
  description="A newsletter and events for the people building tech in Los Angeles."
>
  <span slot="strip-end">About</span>

  {/* ------------------------------------------------------------------ 01 */}
  {/*
    Two columns on wide, and the split is the point: the headline is a
    statement and the prose is the explanation, so they sit beside each other
    rather than one under the other. Top aligned, so the first paragraph's
    x-height lands against the headline's cap.
  */}
  <section class="mx-auto max-w-page px-gutter-sm pt-10 pb-9 wide:px-gutter wide:pt-[52px]">
    <div
      class="grid grid-cols-1 items-start gap-8 wide:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] wide:gap-14"
    >
      <div>
        <div class="t-mono mb-[22px] flex items-center gap-2.5 text-mono-eyebrow text-accent-step">
          <span class="h-px w-[26px] bg-accent-step" aria-hidden="true"></span>
          <span>01 · About</span>
        </div>

        <h1 class="t-display m-0 max-w-[14ch] text-display-2 text-ink">
          {aboutOpening.headline}
        </h1>
      </div>

      <div class="max-w-[56ch] wide:pt-2">
        <p class="m-0 text-body-lg text-ink">{aboutOpening.lead + aboutOpening.rest}</p>
        <p class="mt-5 text-body text-ink-muted-aa">
          Emerging LA is where the people building here now find each other. Founders,
          investors and operators, in one place, across a city that doesn't have one.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ 02 */}
  {/*
    Mission and vision. Two rows of the same template, label and statement.
    Stacked on mobile, label in a fixed left column on wide, which keeps the
    statement on a measure it can be read at: at display-5 across the full page
    these would set as two very long lines, and in a half-width column as six
    short ones.

    Set in .t-title, not .t-display. These are sentences somebody would read
    aloud, and twenty-two words of uppercase Riegal at 46px is a wall.
    See design-system.md §2.
  */}
  <section
    id="mission"
    class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-section"
  >
    <div class="t-mono mb-[22px] flex items-center gap-2.5 text-mono-eyebrow text-accent-step">
      <span class="h-px w-[26px] bg-accent-step" aria-hidden="true"></span>
      <span>02 · Purpose</span>
    </div>

    <div class="border-y border-rule">
      {
        statements.map((statement, i) => (
          <div
            class:list={[
              'grid grid-cols-1 gap-3 py-9 wide:grid-cols-[180px_minmax(0,1fr)] wide:gap-14 wide:py-11',
              i < statements.length - 1 && 'border-b border-hairline',
            ]}
          >
            <h2 class="t-mono m-0 text-mono-label-wide text-ink-muted wide:pt-3">
              {statement.label}
            </h2>
            <p class="t-title m-0 max-w-[38ch] text-display-5 text-ink">{statement.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* -------------------------------------------------------- photo band --- */}
  {/*
    The one unnumbered section on the page: it is a breath between two blocks
    of argument, not an argument of its own.

    Three across on wide. On narrow the three frames stack over each other in
    one slot as the page scrolls, which is CSS only and lives entirely in
    .photo-stack. The wrapper divs are what sticks: PhotoFrame's own figure
    carries `m-0`, and a utility beats a component class, so centring the frame
    has to happen on something outside it.
  */}
  <section class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-section">
    <div class="photo-stack">
      {
        band.map((photo) => (
          <div>
            <PhotoFrame
              variant="portrait"
              src={photo.slot.src}
              alt={photo.slot.alt}
              brief={photo.slot.brief}
              path={photo.path}
            />
          </div>
        ))
      }
    </div>
  </section>

  {/* ------------------------------------------------------------------ 03 */}
  {/*
    Three columns on wide, three stacked blocks on mobile. Cells stretch, so
    the dividers run the full height of the tallest column and a longer block
    just makes the row taller. No items-start here or the ruled ground shows
    through under the shorter cells.
  */}
  <section
    id="what-we-do"
    class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-section"
  >
    <SectionHeader number="03" eyebrow="What we do" title="Three things" class="mb-[34px]" />

    <div class="grid grid-cols-1 gap-px border-y border-rule bg-rule wide:grid-cols-3">
      {
        doing.map((block, i) => (
          <div
            class:list={[
              'bg-ground py-8 wide:px-[26px] wide:py-[34px]',
              i === 0 && 'wide:pl-0',
              i === doing.length - 1 && 'wide:pr-0',
            ]}
          >
            <div class="t-mono mb-3 text-mono-index text-ink-faint">
              {String(i + 1).padStart(2, '0')}
            </div>

            <h3 class="t-title m-0 text-title-2 text-ink">{block.name}</h3>

            {block.paras.map((parts) => (
              <p class="mt-4 max-w-[52ch] text-body-sm text-ink-muted-aa">
                {parts.map((part) =>
                  isSlot(part) ? <span class="text-ink">{part}</span> : part
                )}
              </p>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  {/* ------------------------------------------------------------------ 04 */}
  {/*
    The numbers under what we do, so they sit against the thing they are
    evidence for rather than under the note, which they say nothing about.

    Home's proof strip is unnumbered and runs to the page gutter rather than
    the content column, because there it is a sill under the hero with no label
    of its own. This one carries an eyebrow, so it takes the standard section
    container and its rules line up with every other rule on the page. That is
    the only difference between the two, and the cells are identical.

    A standalone eyebrow with no H2, the way the purpose block above does it. A
    heading here would only say in the display face what the label already says
    in mono.

    Two by two on mobile, four across on wide.
  */}
  <section class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-section">
    <div class="t-mono mb-[22px] flex items-center gap-2.5 text-mono-eyebrow text-accent-step">
      <span class="h-px w-[26px] bg-accent-step" aria-hidden="true"></span>
      <span>04 · By the numbers</span>
    </div>

    <div class="border-y border-rule">
      <div class="grid grid-cols-2 wide:grid-cols-4">
        {
          proof.map((cell, i) => (
            <div
              class:list={[
                'px-[22px] py-[26px]',
                i < proof.length - 1 && 'wide:border-r wide:border-rule',
                i % 2 === 0 && 'border-r border-rule wide:border-r',
                i < 2 && 'border-b border-rule wide:border-b-0',
              ]}
            >
              <div
                class:list={['t-display text-stat', cell.real ? 'text-ink' : 'text-ink-faint']}
              >
                {cell.value}
              </div>
              <div class="t-mono mt-2 text-mono-meta text-ink-muted">{cell.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ 05 */}
  {/*
    Same shape as the purpose rows above: a fixed column on the left, the text
    beside it on a measure it can be read at, and the right edge left open. The
    page has already established that shape twice by the time you reach it.

    The frame is a fixed 240px column, not a fraction of the row: at half width
    a 4/5 frame stands 500px tall and nothing this section will ever hold sits
    beside that without a gap under it. items-start, so neither column stretches
    to the other.

    The note itself is not written yet, so it renders as a marked slot the way
    an empty photo does, at the height four or five sentences will actually
    take, so nothing moves when the copy lands.

    That height is a line count, not a number: a body-lg line is
    var(--text-body-lg) x var(--text-body-lg--line-height), and the slot is
    seven of them wide and nine of them narrow. Both come off the measured
    thing. A note of four or five sentences with a signature under it runs 6 to
    10 lines in this 62ch column at 19px, and 8 to 14 in a phone's 354px column
    at 16px; seven and nine are the middle of those, a five sentence note of
    about 53 words. Setting it on the paragraph rather than the box means the
    padding is not part of the sum, so the count is the count.

    It is also the shorter half of the row on purpose. The portrait is 353px
    and the slot lands at 238px, so the frame anchors the section and the note
    sits beside it, rather than a wide empty rectangle towering over a photo.

    On mobile the frame is capped at 200px, so a 4/5 portrait does not take most
    of a phone screen before the note starts.
  */}
  <section
    id="note"
    class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-section"
  >
    <SectionHeader number="05" eyebrow="Note" title="A note from Brandon" class="mb-[34px]" />

    <div
      class="grid grid-cols-1 items-start gap-7 wide:grid-cols-[240px_minmax(0,1fr)] wide:gap-14"
    >
      <div class="max-w-[200px] wide:max-w-none">
        <PhotoFrame
          variant="portrait"
          src={photos.aboutPortrait.src}
          alt={photos.aboutPortrait.alt}
          brief={photos.aboutPortrait.brief}
          path={photoPaths.aboutPortrait}
        />
      </div>

      <div class="max-w-[62ch] border border-dashed border-edge p-6 wide:p-8">
        <p
          class="m-0 min-h-[calc(9*var(--text-body-lg)*var(--text-body-lg--line-height))] text-body-lg text-ink-muted wide:min-h-[calc(7*var(--text-body-lg)*var(--text-body-lg--line-height))]"
        >
          [SLOT: note from Brandon, four or five sentences, first person, signed.]
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ 06 */}
  <SubscribeBand number="06" />
</SiteLayout>
