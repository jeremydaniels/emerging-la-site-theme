---
/**
 * Stripped chrome, for the /subscribe and /thanks route group.
 *
 * No nav, no footer columns, no top strip. A centred wordmark, the content,
 * and a one-line footer. Nothing on these pages competes with the form.
 *
 * `fill` is what decides where the footer sits when the content is shorter
 * than the window. On by default: the wrapper is at least a viewport tall and
 * main takes the slack, so the footer lands on the bottom edge. /thanks wants
 * that, being three links and a line of text that would otherwise leave the
 * footer stranded halfway up the screen. Pass fill={false} and the page is as
 * tall as its content, footer directly under the last thing on it, which is
 * what a page with real content below the fold wants.
 */
import BaseLayout from './BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import { routes } from '../lib/links';
import { site } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Stretch to the viewport and pin the footer to the bottom. See above. */
  fill?: boolean;
}

const { title, description, noindex = false, fill = true } = Astro.props;
const year = new Date().getFullYear();
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class:list={['flex flex-col px-gutter-sm wide:px-gutter', fill && 'min-h-dvh']}>
    <header class="flex justify-center pt-12 pb-10">
      <Wordmark href={routes.home} width="200px" />
    </header>

    <main id="main" class:list={['mx-auto w-full max-w-[560px]', fill && 'flex-1']}>
      <slot />
    </main>

    <footer
      class="t-mono flex flex-wrap items-center justify-center gap-x-5 gap-y-2 border-t border-rule py-6 text-mono-meta-tight text-ink-muted"
    >
      <span>© {year} {site.name}</span>
      <a href={routes.privacy} class="transition-colors hover:text-accent-step">Privacy</a>
      <a href={routes.terms} class="transition-colors hover:text-accent-step">Terms</a>
    </footer>
  </div>
</BaseLayout>
