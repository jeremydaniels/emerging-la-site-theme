---
/**
 * Home page.
 *
 * Section numbering runs 01 to 05 and restarts on every page.
 *
 * Anchor orange, one live per viewport, in scroll order:
 *   hero CTA  →  featured issue chip  →  featured event row tint  →  the band.
 * Nothing else on this page carries a solid orange fill. The nav's Subscribe
 * is deliberately the outline button.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import RotatingWord from '../components/RotatingWord.astro';
import RotatingWordScript from '../components/RotatingWordScript.astro';
import IssueCard from '../components/IssueCard.astro';
import EventsTable from '../components/EventsTable.astro';
import SubscribeBand from '../components/SubscribeBand.astro';

import { aboutOpening, site } from '../lib/site';
import { routes } from '../lib/links';
import { getLatestIssues } from '../data/issues';
import { upcomingEvents } from '../data/events';
import { photos, photoPaths } from '../data/photos';

const issues = await getLatestIssues(3);
const upcoming = upcomingEvents();

/**
 * Only 15K+ community is a verified number. Every other cell is a visible
 * placeholder, not a guess and not a rounded-down real figure.
 */
const proof = [
  { value: site.communitySize, label: 'Community', real: true },
  { value: '[TBD]', label: 'Issues published', real: false },
  { value: '[TBD]', label: 'Events hosted', real: false },
  { value: '[TBD]', label: 'Companies represented', real: false },
];
---

<SiteLayout title={site.name} suffix={false}>
  {/* strip-end is where the current issue number and date go once there is one. */}

  {/* ------------------------------------------------------------------ 01 */}
  {/*
    Hero. The headline block takes the whole content width and the photo runs
    the whole content width under it, so the page opens as two stacked bands
    rather than a text column beside a picture.

    This is one order on both breakpoints, which is the point: the headline is
    the proposition and it is first on every screen, so the largest paint above
    the fold is a block of text and the photo is the payoff under it. There is
    no wide: on the grid any more because there is nothing to re-arrange, and
    the two layouts differ only in the values below.

    The headline carries no hard breaks and wraps to the column: three lines
    below 505px, two from there up. The one thing holding it together is the
    non-breaking space in "most&nbsp;ambitious". Left to itself the line breaks
    after MOST at every common phone width, which splits the phrase and is the
    break design-system.md §2 sized this step to avoid. The lead keeps its 62ch
    cap, so full width is what the block occupies, not what the sentences
    stretch to.

    The frame is `band`, 3/2, the same preset the About and events bands use,
    capped at --container-hero-photo from 900px up. Uncapped it is 849px of
    well at the 1360px page, which put the proof strip 1.83 viewports down a
    1440 x 900 laptop; capped it is 289px of well and 1.25. The cap is on the
    width because the ratio and the 1800 x 1200 export have to stay honest, and
    a max-height would crop the file rather than fit it. Below 900px the cap
    never binds and the frame fills the column, so the phone layout is the same
    as it was before the cap existed.

    It keeps the four crop marks and loads eager: it is the largest paint under
    the fold on a phone and the only image above it on a laptop.
  */}
  <section class="mx-auto max-w-page px-gutter-sm wide:px-gutter">
    <div class="grid grid-cols-1 gap-gutter pt-10 pb-9 wide:gap-section-sm wide:pt-[52px]">
      <div>
        <div class="t-mono mb-[22px] flex items-center gap-2.5 text-mono-eyebrow text-accent-step">
          <span class="h-px w-[26px] bg-accent-step" aria-hidden="true"></span>
          <span>01 · Start here</span>
        </div>

        <h1 class="t-display m-0 text-display-1 text-ink">
          Home to LA's most&nbsp;ambitious{' '}
          {/*
            The rotating word, and the wash behind it. Both live in
            RotatingWord, measurements included: the reserved width, the em
            table the wash is sized from and the script are one implementation
            shared with the subscribe headline. The step is what picks the
            right row of measurements, because the display steps track
            differently and the words come out different widths.

            It carries its own reserved width, sized to the longest of the
            four words, so the box is the same width whichever one is showing
            and the swap moves nothing. That is what lets the headline wrap
            naturally around it: the line breaks are computed against a
            constant box, not against the word currently in it.
          */}
          <RotatingWord step="display-1" />
        </h1>

        <p class="mt-7 max-w-[62ch] text-lead font-medium text-ink-muted-aa">
          On a mission to put capital, knowledge and opportunity within reach of everyone
          building here.
        </p>

        <div class="mt-[30px] flex flex-wrap items-center gap-[18px]">
          <a href={routes.subscribe} class="btn btn-primary">Subscribe to the newsletter</a>
          <span class="t-mono text-mono-meta-lg text-ink-muted">Unsubscribe anytime</span>
        </div>
      </div>

      <PhotoFrame
        variant="band"
        class="wide:max-w-hero-photo"
        src={photos.homeHero.src}
        alt={photos.homeHero.alt}
        brief={photos.homeHero.brief}
        path={photoPaths.homeHero}
        loading="eager"
      />
    </div>
  </section>

  {/* ------------------------------------------------------ proof strip --- */}
  <section class="px-gutter-sm pt-[34px] wide:px-gutter">
    <div class="mx-auto max-w-page border-y border-rule">
      <div class="grid grid-cols-2 wide:grid-cols-4">
        {
          proof.map((cell, i) => (
            <div
              class:list={[
                'px-[22px] py-[26px]',
                i < proof.length - 1 && 'wide:border-r wide:border-rule',
                i % 2 === 0 && 'border-r border-rule wide:border-r',
                i < 2 && 'border-b border-rule wide:border-b-0',
              ]}
            >
              <div
                class:list={[
                  't-display text-stat',
                  cell.real ? 'text-ink' : 'text-ink-faint',
                ]}
              >
                {cell.value}
              </div>
              <div class="t-mono mt-2 text-mono-meta text-ink-muted">{cell.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ 02 */}
  {/*
    The About page's opening, cut off mid-thought and handed to the link. Both
    pages read it from `aboutOpening` in site.ts, so this is the same sentence
    stopping early rather than a second pitch written to sound like the first.

    Nothing here carries the mission or the vision. Those are stated once, on
    the About page, and a home page that half states them says them twice.
  */}
  <section
    id="about"
    class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-[88px]"
  >
    <div class="grid grid-cols-1 items-start gap-4 wide:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] wide:gap-14">
      <div>
        <div class="t-mono mb-[18px] flex items-center gap-2.5 text-mono-eyebrow text-accent-step">
          <span class="h-px w-[26px] bg-accent-step" aria-hidden="true"></span>
          <span>02 · About</span>
        </div>
        <h2 class="t-display m-0 text-display-4 text-ink">{aboutOpening.headline}</h2>
      </div>

      <div class="pt-1.5">
        {/* The ellipsis is the truncation, so it lives here and not in the
            constant: it is a fact about this block, not about the sentence. */}
        <p class="m-0 text-body-lg text-ink">{aboutOpening.lead}...</p>
        <a href={routes.about} class="btn-quiet mt-8">Read more about us →</a>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ 03 */}
  <section
    id="issues"
    class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-section"
  >
    <SectionHeader number="03" eyebrow="Newsletter" title="Latest issues" class="mb-[34px]">
      <a
        slot="action"
        href={routes.archive}
        class="t-mono pb-1 text-mono-meta-lg text-accent-step">Read the archive →</a
      >
    </SectionHeader>

    <div class="grid grid-cols-1 gap-4 wide:grid-cols-3 wide:gap-[26px]">
      {issues.map((issue, i) => <IssueCard issue={issue} accent={i === 0} />)}
    </div>

    <div class="mt-9 flex justify-center">
      <a href={routes.archive} class="btn btn-secondary">See all issues in the archive</a>
    </div>
  </section>

  {/* ------------------------------------------------------------------ 04 */}
  {/*
    The whole section is absent when there is nothing upcoming, rather than
    sitting there empty. Past events live on the events page.
  */}
  {
    upcoming.length > 0 && (
      <section
        id="events"
        class="mx-auto max-w-page px-gutter-sm pt-section-sm wide:px-gutter wide:pt-section"
      >
        <SectionHeader number="04" eyebrow="Events" title="Upcoming events" class="mb-3" />

        <p class="mt-0 mb-[26px] text-body-sm text-ink-muted-aa">
          Anyone can attend. RSVP to hold a spot.
        </p>

        <EventsTable events={upcoming} variant="upcoming" />

        <div class="flex flex-wrap items-center justify-between gap-3.5 pt-[22px]">
          <span class="t-mono text-mono-meta-lg text-ink-muted">
            More dates added regularly
          </span>
          <a href={routes.events} class="btn-quiet">
            See all events →
          </a>
        </div>
      </section>
    )
  }

  {/* ------------------------------------------------------------------ 05 */}
  <SubscribeBand number="05" />

</SiteLayout>

{/* The rotating word's behaviour. Here rather than in RotatingWord because a
    script inside that component would render inside the h1: see the note in
    RotatingWordScript. */}
<RotatingWordScript />
