---
/**
 * Site footer. Ink ground in both modes, so it carries `.on-ink` and every
 * token inside it re-points. See design-system.md §14.
 */
import Wordmark from './Wordmark.astro';
import { links, routes } from '../lib/links';
import { site } from '../lib/site';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Sections',
    items: [
      { label: 'About', href: routes.about },
      { label: 'Archive', href: routes.archive },
      { label: 'Events', href: routes.events },
      { label: 'Subscribe', href: routes.subscribe },
    ],
  },
  {
    heading: 'Get involved',
    items: [
      { label: 'Host an event', href: links.email },
      { label: 'Partner with us', href: links.email },
      { label: 'Submit a story', href: links.email },
      { label: 'Advertise', href: links.email },
    ],
  },
  {
    heading: 'Contact',
    items: [
      { label: 'Email', href: links.email },
      { label: 'LinkedIn', href: links.linkedin },
      { label: 'Instagram', href: links.instagram },
      { label: 'X', href: links.x },
    ],
  },
];
---

{/* The top rule is what separates the footer in dark mode, where its ground
    matches the page. In light mode the ink block separates itself. */}
<footer class="on-ink border-t border-rule bg-ground text-ink">
  <div class="px-gutter-sm pt-14 pb-[34px] wide:px-gutter">
    <div class="mx-auto max-w-page">
      <div class="grid grid-cols-1 gap-4 wide:grid-cols-[minmax(0,1.5fr)_repeat(3,minmax(0,0.75fr))] wide:gap-10">
        <div>
          <Wordmark tone="cream" href={null} width="clamp(220px, 26vw, 340px)" />
          <p class="mt-[18px] max-w-[36ch] text-body-sm text-ink-muted">
            {site.description}
          </p>
          <a href={routes.subscribe} class="btn btn-primary btn-sm mt-[22px]">Subscribe</a>
        </div>

        {
          columns.map((col) => (
            <div>
              <div class="t-mono mb-[15px] text-mono-head text-accent-light">
                {col.heading}
              </div>
              <nav class="flex flex-col gap-2.5" aria-label={col.heading}>
                {col.items.map((item) => (
                  <a
                    href={item.href}
                    class="text-ui text-ink-muted transition-colors hover:text-accent-light"
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            </div>
          ))
        }
      </div>

      <div
        class="t-mono mt-11 flex flex-wrap items-center justify-between gap-3.5 border-t border-rule pt-[22px] text-mono-meta-tight text-ink-faint"
      >
        <span>© {year} {site.name} · {site.location}</span>
        <div class="flex gap-5">
          <a href={routes.privacy} class="transition-colors hover:text-accent-light">Privacy</a>
          <a href={routes.terms} class="transition-colors hover:text-accent-light">Terms</a>
        </div>
      </div>
    </div>
  </div>
</footer>
