---
/**
 * The shell for /preview/* pages.
 *
 * ============================================================================
 *  THESE PAGES ARE THROWAWAY.
 *
 *  A /preview route exists so somebody can look at a newsletter issue type on
 *  a phone and approve its structure. It is not part of the public site: no
 *  nav link, no sitemap entry, nothing in the archive, noindex on every page.
 *  It WILL go stale as the issue types change, and that is fine. Delete a
 *  preview once its issue type is signed off.
 * ============================================================================
 *
 * Adding a second one is a page plus its content. This layout, PullQuote,
 * FactTable, PlatePair and the site's own components carry everything else.
 */
import SiteLayout from './SiteLayout.astro';

interface Props {
  /** The issue title. Used for <title> and the strip. */
  title: string;
  description?: string;
  /** Short label for the ink strip, e.g. "Event recap". */
  kind: string;
}

const { title, description, kind }: Props = Astro.props;
---

<SiteLayout title={title} description={description} noindex>
  <span slot="strip-end">Preview · {kind}</span>

  {/*
    The gutter lives here, outside the 1360px cap, and the issue's sections
    carry only `mx-auto max-w-page`.

    That is Footer.astro's pattern, and it is the reason the issue's rules line
    up with the footer's at every width. The other pattern on this site puts
    the padding inside the cap, which lands content 30px short of the footer
    once the viewport passes 1360px. Both are in use across the site; this page
    picks the one the footer uses so there is a single right edge on the page.
  */}
  <div class="px-gutter-sm wide:px-gutter">
    {/*
      Says what this page is, in the site's own metadata voice rather than as a
      banner. It sits above the issue so nobody mistakes a preview URL for a
      published issue, and it is the first thing to delete when these go.
    */}
    <div class="mx-auto max-w-page pt-7">
      <div
        class="t-mono flex flex-wrap items-baseline gap-x-5 gap-y-2 border-y border-rule py-3 text-mono-meta text-ink-muted"
      >
        <span class="text-ink">Preview</span>
        <span>Not published · Structure only</span>
        <span class="wide:ml-auto">Bracketed values are placeholders</span>
      </div>
    </div>

    <slot />
  </div>
</SiteLayout>
